# Copy to .env and edit. Nothing here is required: with no settings at all the
# demos run against the offline ScriptedChatModel.

# scripted (default) | ollama | anthropic | openai | ...
# LC_PROVIDER=ollama

# Model name for the chosen provider.
# LC_MODEL=llama3.1

# Optional: send traces to LangSmith.
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=
